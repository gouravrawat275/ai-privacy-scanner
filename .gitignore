__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Downloaded optional model weights (fetched by scripts/download_models.py)
models/*.prototxt
models/*.caffemodel

# Local test artifacts
tests/_synthetic_test.jpg
tests/_no_exif.png
