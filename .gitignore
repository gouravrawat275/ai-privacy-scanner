# Runtime data — scan history and login credentials/sessions are
# per-install state, not source. If you fork this project, you almost
# certainly don't want your own auth_config.yaml (real password hashes
# and cookie signing key) or scan_history.db committed to a public repo.
data/*.db
auth_config.yaml

# OS junk
.DS_Store
Thumbs.db
